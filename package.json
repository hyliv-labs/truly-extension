  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "check": "tsx scripts/e1-check.ts && tsx scripts/owner-rotation-check.ts && tsx scripts/anon-rpc-gate-check.ts && tsx scripts/paymaster-check.ts && tsx scripts/notes-check.ts && tsx scripts/wallet-seed-check.ts && tsx scripts/deposit-index-check.ts && tsx scripts/metamask-recovery-check.ts && tsx scripts/exit-check.ts && tsx scripts/retire-check.ts && tsx scripts/relayer-fee-check.ts && tsx scripts/withdrawal-index-check.ts && tsx scripts/discovery-anon-check.ts && tsx scripts/asp-cache-check.ts",
    "copy:anon-rpc": "tsx scripts/copy-anon-rpc.ts",
    "predev": "tsx scripts/copy-anon-rpc.ts && tsx scripts/fetch-circuits.ts",
    "prebuild": "tsx scripts/copy-anon-rpc.ts && tsx scripts/fetch-circuits.ts",
    "check:lighter": "tsx scripts/lighter-check.ts",
    "fetch:circuits": "tsx scripts/fetch-circuits.ts",
    "check:circuits": "tsx scripts/circuits-check.ts",
    "check:withdrawal": "tsx scripts/withdrawal-proof-check.ts",
    "check:account": "tsx scripts/account-service-check.ts",
    "check:logrange": "tsx scripts/log-range-check.ts",
    "check:asproot": "tsx scripts/asp-root-rule-check.ts",
    "check:relayer": "tsx scripts/relayer-quote-check.ts"
  },
  "dependencies": {
    "@0xbow/privacy-pools-core-sdk": "^1.5.0",
    "@anon-rpc/browser-extension-harness": "^0.4.0",
    "@anon-rpc/browser-harness": "^0.4.0",
    "@metamask/providers": "22.1.1",
    "@noble/hashes": "^2.4.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "^2.57.16"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.33",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@wxt-dev/module-react": "^1.2.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wxt": "^0.21.5"
