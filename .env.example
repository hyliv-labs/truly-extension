# Copy to .env.local and fill in. WXT exposes only WXT_-prefixed vars.
#
# The Privacy Pools values below are no longer open questions: every one was
# verified on chain (docs/privacy-pools-deployment.md), and the real values
# are the ones shown as defaults in the comments.

# The anon-rpc IWorkerSpecifier contract. Defaults to tor-js from anon-rpc's
# adopters.json5, which really anonymises. Leave blank to use that default.
# Do NOT use the passthrough worker: it is a reference that fulfils calls with
# an ordinary fetch, so nothing is anonymised.
WXT_ANON_RPC_SPECIFIER=

# Read ONCE, only to resolve the specifier contract above.
# ETHEREUM mainnet, not Arbitrum: that is the chain the specifier lives on.
WXT_BOOTSTRAP_RPC_URL=https://ethereum-rpc.publicnode.com

# Where the anon-client proxies Arbitrum reads.
WXT_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Widest eth_getLogs range this provider serves, in blocks. A property of the
# PROVIDER, not of Arbitrum: arb1.arbitrum.io allows 10,000,000, which makes a
# full note-discovery scan 12 calls instead of the SDK default's 11,044. Many
# providers cap far lower. Blank uses the measured default.
WXT_LOG_CHUNK_SIZE=

# Privacy Pools CORE (v1) on Arbitrum One, USDC pool — NOT the v2 monorepo.
# These answer SCOPE/ASSET/ENTRYPOINT/dead, which is the compatibility proof;
# v2 has no contract with that surface. src/lib/pool.ts re-reads all of it at
# runtime and refuses to proceed on any mismatch.
#   entrypoint 0x44192215FEd782896BE2CE24E0Bfbf0BF825d15E
#   pool       0x3706e38af05bf0158BCdbB46239f8289980b093f
#   relayer    https://fastrelay.xyz
WXT_PRIVACY_POOL_ENTRYPOINT=
WXT_PRIVACY_POOL_ADDRESS=
WXT_PRIVACY_POOL_RELAYER_URL=

# ERC-4337 bundler for the re-shield user operation.
# Defaults to Pimlico's public endpoint, which Circle's own samples use.
# Undocumented rate limits — set a dedicated URL before the demo.
WXT_BUNDLER_URL=

# The pool's scope, an input to note derivation. A wrong scope derives notes
# for a pool the funds are not in. Read from the pool's SCOPE():
#   19314316433070648921215665277427138450050666275686107272761703472573535400848
# Configured only as a cross-check; the chain's value is authoritative.
WXT_PRIVACY_POOL_SCOPE=

# USDC units to draw from the pool per trade (6 decimals). Blank = 25 USDC.
# The relayer's effective rate is fixed-cost dominated — 68 BPS at the 5 USDC
# pool floor versus 11 at 250 — so small trades pay a punitive rate.
WXT_TRADE_SIZE_UNITS=

# The ASP API. Overriding this needs a matching host_permissions entry in
# wxt.config.ts, or the worker's fetch is blocked by CORS.
WXT_ASP_API_BASE=
