# Copy to .env.local and fill in. WXT exposes only WXT_-prefixed vars.

# The anon-rpc IWorkerSpecifier contract for Arbitrum reads.
# OPEN: confirm the correct specifier at the Ethereum Foundation booth.
# Until this is set, every chain read is refused and money-moving steps block.
WXT_ANON_RPC_SPECIFIER=

# Read once, only to resolve the specifier contract above.
WXT_BOOTSTRAP_RPC_URL=https://arb1.arbitrum.io/rpc

# Where the anon-client proxies Arbitrum reads.
WXT_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
